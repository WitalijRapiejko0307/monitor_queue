# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user ids with admin access to /trace, /trace_user, /last_errors, /status, /force_fetch
ADMIN_TELEGRAM_IDS=

# PostgreSQL connection string (Railway provides this automatically as DATABASE_URL)
# Example: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/queue_monitor

# Timezone used for scheduling and displaying crossing times (Minsk)
TIMEZONE=Europe/Minsk

# GPK source page
GPK_SOURCE_URL=https://gpk.gov.by/situation-at-the-border/

# Fetch GPK data every N minutes after each even hour (0 = exactly on the even hour)
FETCH_OFFSET_MINUTES=10

# Payment provider token for Telegram Bot Payments (empty = payments disabled, stub mode)
PAYMENT_PROVIDER_TOKEN=

# Currency code used for invoices
PAYMENT_CURRENCY=BYN

# Default prices (in minor units, e.g. kopecks: 500 = 5.00 BYN) per vehicle type
PRICE_CAR_MINOR=500
PRICE_TRUCK_MINOR=900
